APP_NAME="SaaS Keuangan WAHA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://macau.mcdigits.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_waha_bot
DB_USERNAME=saas_waha_bot
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=macau.mcdigits.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=CHANGE_ME
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WAHA_DEFAULT_SESSION=default
WAHA_ATTACHMENT_DISK=local
WAHA_ATTACHMENT_MAX_BYTES=5242880

SUPPORT_WHATSAPP_NUMBER=
SUPPORT_WHATSAPP_MESSAGE="Halo tim support, saya {{user_name}} dari tenant {{tenant_name}} butuh bantuan terkait penggunaan aplikasi."
SUPPORT_FEEDBACK_FORM_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@macau.mcdigits.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
